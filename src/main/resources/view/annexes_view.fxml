<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="18.0"
      styleClass="annexes-page"
      stylesheets="@../css/Annexe.css"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.contact.controller.AnnexesController">

    <padding>
        <Insets top="22" right="24" bottom="20" left="24"/>
    </padding>

    <children>

        <!-- ================= EN-TÊTE ================= -->
        <HBox alignment="CENTER_LEFT"
              spacing="20"
              styleClass="annexes-header">

            <children>

                <HBox alignment="CENTER"
                      styleClass="header-icon-container"
                      minWidth="54"
                      minHeight="54">

                    <children>
                        <FontIcon iconLiteral="fas-map-marked-alt"
                                  iconSize="23"
                                  styleClass="header-icon"/>
                    </children>
                </HBox>

                <VBox spacing="5" styleClass="header-text">
                    <children>
                        <Label text="Annexes &amp; Régions limitrophes"
                               styleClass="page-title"/>

                        <Label text="Gestion des contacts et responsables des régions voisines : Menabe, Ihorombe, Androy et Anosy."
                               styleClass="page-subtitle"/>
                    </children>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="CENTER_RIGHT"
                      spacing="10"
                      styleClass="header-actions">

                    <children>

                        <Button fx:id="btnExporterExcel"
                                text="Exporter Excel"
                                mnemonicParsing="false"
                                onAction="#exporterExcel"
                                styleClass="btn-export-excel">

                            <graphic>
                                <FontIcon iconLiteral="fas-file-excel"
                                          iconSize="14"/>
                            </graphic>
                        </Button>

                        <Button fx:id="btnAjouterContactAnnexe"
                                text="Nouveau contact"
                                mnemonicParsing="false"
                                onAction="#ouvrirFenetreNouveauContact"
                                styleClass="add-button">

                            <graphic>
                                <FontIcon iconLiteral="fas-plus"
                                          iconSize="13"/>
                            </graphic>
                        </Button>

                    </children>
                </HBox>

            </children>
        </HBox>


        <!-- ================= BARRE DE FILTRES ================= -->
        <VBox spacing="10" styleClass="filter-card">

            <children>

                <HBox alignment="CENTER_LEFT" spacing="7">
                    <children>
                        <FontIcon iconLiteral="fas-sliders-h"
                                  iconSize="13"
                                  styleClass="filter-heading-icon"/>

                        <Label text="FILTRER LES CONTACTS"
                               styleClass="filter-heading"/>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT"
                      spacing="10"
                      styleClass="toolbar">

                    <children>

                        <ComboBox fx:id="cbFiltreRegionLimitrophe"
                                  promptText="Région limitrophe"
                                  prefWidth="175"
                                  prefHeight="40"
                                  styleClass="filter-combo"/>

                        <ComboBox fx:id="cbFiltreDistrict"
                                  promptText="District"
                                  prefWidth="155"
                                  prefHeight="40"
                                  disable="true"
                                  styleClass="filter-combo"/>

                        <ComboBox fx:id="cbFiltreCommune"
                                  promptText="Commune"
                                  prefWidth="155"
                                  prefHeight="40"
                                  disable="true"
                                  styleClass="filter-combo"/>

                        <ComboBox fx:id="cbFiltreFokotany"
                                  promptText="Fokotany"
                                  prefWidth="145"
                                  prefHeight="40"
                                  disable="true"
                                  styleClass="filter-combo"/>

                        <HBox alignment="CENTER_LEFT"
                              spacing="9"
                              styleClass="search-container"
                              HBox.hgrow="ALWAYS">

                            <children>

                                <FontIcon iconLiteral="fas-search"
                                          iconSize="15"
                                          styleClass="search-icon-element"/>

                                <TextField fx:id="txtRecherche"
                                           promptText="Rechercher un nom, une fonction, un téléphone..."
                                           styleClass="search-field"
                                           HBox.hgrow="ALWAYS"/>

                            </children>
                        </HBox>

                    </children>
                </HBox>

            </children>
        </VBox>


        <!-- ================= TABLEAU ================= -->
        <VBox spacing="0"
              styleClass="table-card"
              VBox.vgrow="ALWAYS">

            <children>

                <!-- En-tête du tableau -->
                <HBox alignment="CENTER_LEFT"
                      spacing="12"
                      styleClass="table-card-header">

                    <padding>
                        <Insets top="17" right="20" bottom="17" left="20"/>
                    </padding>

                    <children>

                        <VBox spacing="4">
                            <children>
                                <Label text="Répertoire des contacts"
                                       styleClass="table-title"/>

                                <Label text="Liste des responsables et forces de l'ordre affectés aux régions limitrophes."
                                       styleClass="table-subtitle"/>
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <HBox alignment="CENTER"
                              spacing="7"
                              styleClass="table-status">

                            <children>
                                <FontIcon iconLiteral="fas-database"
                                          iconSize="12"
                                          styleClass="status-icon"/>

                                <Label text="Répertoire"
                                       styleClass="status-text"/>
                            </children>
                        </HBox>

                    </children>
                </HBox>


                <!-- Tableau des contacts -->
                <TableView fx:id="tableViewContacts"
                           styleClass="contacts-table"
                           VBox.vgrow="ALWAYS">

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>

                    <placeholder>
                        <VBox alignment="CENTER" spacing="10">
                            <children>
                                <FontIcon iconLiteral="fas-folder-open"
                                          iconSize="32"
                                          styleClass="empty-icon"/>

                                <Label text="Aucun contact disponible"
                                       styleClass="empty-title"/>

                                <Label text="Les contacts correspondant à votre sélection apparaîtront ici."
                                       styleClass="empty-subtitle"/>
                            </children>
                        </VBox>
                    </placeholder>

                    <columns>

                        <TableColumn fx:id="colRegion"
                                     text="RÉGION"
                                     minWidth="90"
                                     prefWidth="115"/>

                        <TableColumn fx:id="colNom"
                                     text="NOM COMPLET"
                                     minWidth="120"
                                     prefWidth="170"/>

                        <TableColumn fx:id="colFonction"
                                     text="FONCTION"
                                     minWidth="100"
                                     prefWidth="150"/>

                        <TableColumn fx:id="colDistrict"
                                     text="DISTRICT"
                                     minWidth="80"
                                     prefWidth="110"/>

                        <TableColumn fx:id="colCommune"
                                     text="COMMUNE"
                                     minWidth="80"
                                     prefWidth="110"/>

                        <TableColumn fx:id="colFokotany"
                                     text="FOKOTANY"
                                     minWidth="80"
                                     prefWidth="110"/>

                        <TableColumn fx:id="colTelephone"
                                     text="TÉLÉPHONE"
                                     minWidth="110"
                                     prefWidth="125"
                                     styleClass="col-telephone"/>

                        <TableColumn fx:id="colMotif"
                                     text="MOTIF"
                                     minWidth="75"
                                     prefWidth="110"/>

                        <TableColumn fx:id="colActions"
                                     text="ACTIONS"
                                     minWidth="90"
                                     prefWidth="95"
                                     maxWidth="95"
                                     styleClass="action-column"/>

                    </columns>
                </TableView>


                <!-- Pied du tableau -->
                <HBox alignment="CENTER_LEFT"
                      styleClass="table-footer">

                    <padding>
                        <Insets top="11" right="20" bottom="11" left="20"/>
                    </padding>

                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="7">
                            <children>
                                <FontIcon iconLiteral="fas-shield-alt"
                                          iconSize="12"
                                          styleClass="footer-icon"/>

                                <Label text="ANNEXES &amp; RÉGIONS LIMITROPHES"
                                       styleClass="footer-label"/>
                            </children>
                        </HBox>
                    </children>
                </HBox>

            </children>
        </VBox>

    </children>
</VBox>
