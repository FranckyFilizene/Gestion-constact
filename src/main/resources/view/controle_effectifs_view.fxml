<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="22.0" styleClass="page-root"
      stylesheets="@../css/effectifs.css"
      xmlns="http://javafx.com/javafx/25.0.4"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.contact.controller.ControleEffectifsController">
   <children>

      <!-- En-tête -->
      <HBox alignment="CENTER_LEFT" spacing="14.0">
         <children>
            <StackPane styleClass="header-icon-box">
               <children>
                  <FontIcon iconLiteral="fas-chart-line" iconSize="22" styleClass="header-icon" />
               </children>
            </StackPane>
            <VBox spacing="3.0">
               <children>
                  <Label styleClass="page-title" text="Tableau de Bord - Contrôle des Effectifs" />
                  <Label styleClass="page-subtitle" text="Suivi en temps réel des postes clés (Maires, Vigiles, KMD) et alertes de manquants" />
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- Cartes KPI -->
      <HBox spacing="18.0">
         <children>

            <!-- Carte 1 : Postes ciblés -->
            <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="kpi-card, kpi-blue" HBox.hgrow="ALWAYS">
               <children>
                  <StackPane styleClass="kpi-icon-box, icon-box-blue">
                     <children>
                        <FontIcon iconLiteral="fas-briefcase" iconSize="22" styleClass="kpi-icon, icon-blue" />
                     </children>
                  </StackPane>
                  <VBox spacing="2.0">
                     <children>
                        <Label styleClass="kpi-title" text="POSTES CIBLÉS" />
                        <Label fx:id="lblTotalPostes" styleClass="kpi-value" text="0" />
                        <Label styleClass="kpi-caption" text="Total des postes suivis" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- Carte 2 : Postes complets -->
            <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="kpi-card, kpi-green" HBox.hgrow="ALWAYS">
               <children>
                  <StackPane styleClass="kpi-icon-box, icon-box-green">
                     <children>
                        <FontIcon iconLiteral="fas-check-circle" iconSize="22" styleClass="kpi-icon, icon-green" />
                     </children>
                  </StackPane>
                  <VBox spacing="2.0">
                     <children>
                        <Label styleClass="kpi-title, title-green" text="POSTES COMPLETS" />
                        <Label fx:id="lblPostesComplets" styleClass="kpi-value, value-green" text="0" />
                        <Label styleClass="kpi-caption" text="Effectif atteint" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- Carte 3 : Déficit -->
            <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="kpi-card, kpi-red" HBox.hgrow="ALWAYS">
               <children>
                  <StackPane styleClass="kpi-icon-box, icon-box-red">
                     <children>
                        <FontIcon iconLiteral="fas-exclamation-triangle" iconSize="22" styleClass="kpi-icon, icon-red" />
                     </children>
                  </StackPane>
                  <VBox spacing="2.0">
                     <children>
                        <Label styleClass="kpi-title, title-red" text="EN DÉFICIT (MANQUANTS)" />
                        <Label fx:id="lblPostesDeficit" styleClass="kpi-value, value-red" text="0" />
                        <Label styleClass="kpi-caption" text="Postes à pourvoir" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- Carte 4 : Personnes suspectes -->
            <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="kpi-card, kpi-purple" HBox.hgrow="ALWAYS">
               <children>
                  <StackPane styleClass="kpi-icon-box, icon-box-purple">
                     <children>
                        <FontIcon iconLiteral="fas-user-secret" iconSize="22" styleClass="kpi-icon, icon-purple" />
                     </children>
                  </StackPane>
                  <VBox spacing="2.0">
                     <children>
                        <Label styleClass="kpi-title, title-purple" text="PERSONNES SUSPECTES" />
                        <Label fx:id="lblPersonnesSuspectes" styleClass="kpi-value, value-purple" text="0" />
                        <Label styleClass="kpi-caption" text="Signalements en cours" />
                     </children>
                  </VBox>
               </children>
            </HBox>

         </children>
      </HBox>

      <!-- Tableau -->
      <VBox spacing="10.0" styleClass="table-card" VBox.vgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <FontIcon iconLiteral="fas-list-ul" iconSize="15" styleClass="section-icon" />
                  <Label styleClass="section-title" text="Détail des effectifs par localité" />
               </children>
            </HBox>

            <TableView fx:id="tableEffectifs" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colLocalite" prefWidth="200.0" text="Localité" />
                  <TableColumn fx:id="colTypeLocalite" prefWidth="130.0" text="Type" />
                  <TableColumn fx:id="colFonction" prefWidth="220.0" text="Fonction / Poste" />
                  <TableColumn fx:id="colPrevu" prefWidth="100.0" styleClass="col-center" text="Prévu" />
                  <TableColumn fx:id="colActuel" prefWidth="100.0" styleClass="col-center" text="Actuel" />
                  <TableColumn fx:id="colManquant" prefWidth="120.0" styleClass="col-center" text="Manquant (Déficit)" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <placeholder>
                  <Label styleClass="placeholder-label" text="Aucune donnée à afficher" />
               </placeholder>
            </TableView>
         </children>
      </VBox>

   </children>
</VBox>