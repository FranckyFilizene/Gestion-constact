<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="rootJournal" spacing="16.0" styleClass="content-area"
      stylesheets="@../css/journal.css"
      xmlns="http://javafx.com/javafx/25.0.4"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.contact.controller.JournalController">

   <padding>
      <Insets top="24" right="28" bottom="24" left="28"/>
   </padding>

   <children>
      <!-- En-tête -->
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label text="Journal d'audit" styleClass="page-title"/>
                  <Label text="Historique des actions et événements enregistrés dans le système." styleClass="page-subtitle"/>
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnActualiser" text="Actualiser" onAction="#actualiserJournal" styleClass="primary-button"/>
         </children>
      </HBox>

      <!-- Filtres -->
      <HBox spacing="12.0" alignment="CENTER_LEFT">
         <children>
            <ComboBox fx:id="cbFiltreAction" prefWidth="200.0" promptText="Toutes les actions"/>
            <TextField fx:id="txtRecherche" promptText="Rechercher (utilisateur, table, détails...)" HBox.hgrow="ALWAYS"/>
         </children>
      </HBox>

      <!-- Tableau des entrées du journal -->
      <TableView fx:id="tableJournal" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colDate" text="Date &amp; Heure" prefWidth="165.0"/>
            <TableColumn fx:id="colUtilisateur" text="Utilisateur" prefWidth="170.0"/>
            <TableColumn fx:id="colAction" text="Action" prefWidth="135.0"/>
            <TableColumn fx:id="colTable" text="Table cible" prefWidth="130.0"/>
            <TableColumn fx:id="colIdCible" text="ID cible" prefWidth="85.0"/>
            <TableColumn fx:id="colDetails" text="Détails" prefWidth="420.0"/>
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>