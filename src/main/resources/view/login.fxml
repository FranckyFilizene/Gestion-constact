<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.CheckBox?>

<StackPane prefHeight="600.0" prefWidth="950.0"
           styleClass="root-pane"
           stylesheets="@../css/login.css"
           xmlns="http://javafx.com/javafx/26"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.contact.controller.LoginController">

    <children>

        <HBox maxWidth="850.0" maxHeight="490.0"
              styleClass="main-container">

            <!-- PANNEAU GAUCHE -->
            <VBox alignment="CENTER_LEFT"
                  prefWidth="360.0"
                  spacing="22.0"
                  styleClass="brand-panel">

                <padding>
                    <Insets top="45" right="35"
                            bottom="45" left="35"/>
                </padding>

                <children>

                    <Label text="GCA"
                           styleClass="brand-logo"/>

                    <Label text="GESTION DES CONTACTS"
                           wrapText="true"
                           styleClass="brand-title"/>

                    <Label text="RÉGION ATSIMO-ANDREFANA"
                           styleClass="brand-subtitle"/>

                    <Label text="Une plateforme centralisée pour
gérer, organiser et retrouver
facilement vos contacts administratifs."
                           wrapText="true"
                           styleClass="brand-description"/>

                    <VBox spacing="12.0"
                          styleClass="feature-list">

                        <Label text="✓  Gestion des contacts"
                               styleClass="feature-label"/>

                        <Label text="✓  Organisation administrative"
                               styleClass="feature-label"/>

                        <Label text="✓  Recherche rapide"
                               styleClass="feature-label"/>

                        <Label text="✓  Gestion sécurisée"
                               styleClass="feature-label"/>

                    </VBox>

                    <Label text="© 2026 - Région Atsimo-Andrefana"
                           styleClass="copyright-label"/>

                </children>
            </VBox>

            <!-- PANNEAU DROIT -->
            <VBox alignment="CENTER"
                  prefWidth="490.0"
                  spacing="17.0"
                  styleClass="form-panel">

                <padding>
                    <Insets top="40" right="55"
                            bottom="40" left="55"/>
                </padding>

                <children>

                    <VBox spacing="7.0">
                        <Label fx:id="lblTitre"
                               text="Bienvenue !"
                               styleClass="title-label"/>

                        <Label fx:id="lblSousTitre"
                               text="Connectez-vous à votre espace de gestion."
                               wrapText="true"
                               styleClass="subtitle-label"/>
                    </VBox>

                    <!-- NOM COMPLET -->
                    <VBox fx:id="boxNomComplet"
                          managed="false"
                          visible="false"
                          spacing="7.0">

                        <Label text="Nom complet"
                               styleClass="field-label"/>

                        <TextField fx:id="txtNomComplet"
                                   promptText="Ex : Jean Rakoto"
                                   styleClass="input-field"/>

                    </VBox>

                    <!-- IDENTIFIANT -->
                    <VBox spacing="7.0">
                        <Label text="Identifiant"
                               styleClass="field-label"/>

                        <TextField fx:id="txtLogin"
                                   prefHeight="46.0"
                                   promptText="Saisissez votre identifiant"
                                   styleClass="input-field"/>
                    </VBox>

                    <!-- MOT DE PASSE -->
                    <!-- MOT DE PASSE -->
                    <VBox spacing="7.0">
                        <Label text="Mot de passe"
                               styleClass="field-label"/>

                        <StackPane>
                            <!-- Mot de passe masqué -->
                            <PasswordField fx:id="txtPassword"
                                           prefHeight="46.0"
                                           promptText="Saisissez votre mot de passe"
                                           styleClass="input-field"/>

                            <!-- Mot de passe visible -->
                            <TextField fx:id="txtPasswordVisible"
                                       prefHeight="46.0"
                                       promptText="Saisissez votre mot de passe"
                                       styleClass="input-field"
                                       visible="false"
                                       managed="false"/>
                        </StackPane>

                        <!-- CHECKBOX -->
                        <CheckBox fx:id="chkAfficherPassword"
                                  text="Afficher le mot de passe"
                                  onAction="#tooglePasswordVisibility"
                                  styleClass="password-checkbox"/>
                    </VBox>

                    <!-- À ajouter juste après le VBox du MOT DE PASSE -->
                    <VBox fx:id="boxConfirmPassword"
                          managed="false"
                          visible="false"
                          spacing="7.0">
                        <Label text="Confirmer le mot de passe"
                               styleClass="field-label"/>
                        <PasswordField fx:id="txtConfirmPassword"
                                       prefHeight="46.0"
                                       promptText="Confirmez votre mot de passe"
                                       styleClass="input-field"/>
                    </VBox>

                    <!-- MESSAGE -->
                    <Label fx:id="lblMessage"
                           wrapText="true"
                           styleClass="error-label"/>

                    <!-- BOUTON -->
                    <Button fx:id="btnAction"
                            text="Se connecter"
                            onAction="#handleAction"
                            maxWidth="Infinity"
                            prefHeight="48.0"
                            styleClass="primary-button"/>

                    <!-- INSCRIPTION -->
                    <HBox alignment="CENTER" spacing="5.0">
                        <Label fx:id="lblSwitchText"
                               text="Vous n'avez pas de compte ?"
                               styleClass="switch-label"/>

                        <Hyperlink fx:id="linkSwitch"
                                   text="Créer un compte"
                                   onAction="#switchMode"
                                   styleClass="switch-link"/>
                    </HBox>

                </children>
            </VBox>

        </HBox>

    </children>
</StackPane>
