<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="contacts-page" stylesheets="@../css/contacts.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.contact.controller.ContactListController">

   <padding>
      <Insets bottom="25" left="28" right="28" top="25" />
   </padding>

   <children>

      <!-- EN-TETE DE LA PAGE -->
      <HBox alignment="CENTER_LEFT" prefHeight="58.0" prefWidth="876.0" spacing="15.0" styleClass="page-header">

         <children>

            <VBox spacing="6.0">

               <Label styleClass="page-title" text="Gestion des Contacts" />

               <Label styleClass="page-subtitle" text="Consultez, recherchez et gérez l'annuaire territorial de la région." />

            </VBox>

            <HBox HBox.hgrow="ALWAYS" />

                        <!-- BOUTON AJOUTER -->
            <Button fx:id="btnAjouterContact" mnemonicParsing="false" onAction="#handleAjouter" prefHeight="43.0" styleClass="add-button" text="+  Nouveau contact" />

         </children>
      </HBox>
      <Separator prefWidth="200.0" />


      <!-- BARRE D'OUTILS -->
      <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="toolbar">

         <children>

            <!-- COMBOBOX DES FILTRES DE MENUS -->
            <ComboBox fx:id="cbFiltreMenu" prefHeight="43.0" prefWidth="190.0" promptText="Tous les menus" styleClass="filter-combo" />
            <ComboBox fx:id="cbFiltreDistrict" layoutX="10.0" layoutY="15.0" prefHeight="43.0" prefWidth="190.0" promptText="Tous les districts" styleClass="filter-combo" />

            <!-- RECHERCHE -->
            <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="search-container" HBox.hgrow="ALWAYS">

               <Label styleClass="search-icon" text="⌕" />

               <TextField fx:id="txtRecherche" promptText="Rechercher par nom, fonction, district ou téléphone..." styleClass="search-field" HBox.hgrow="ALWAYS" />

            </HBox>

         </children>

      </HBox>



      <!-- CARTE DU TABLEAU -->
      <VBox spacing="0.0" styleClass="table-card" VBox.vgrow="ALWAYS">

         <children>

            <!-- TITRE DU TABLEAU -->
            <HBox alignment="CENTER_LEFT" prefHeight="21.0" prefWidth="873.0" styleClass="table-card-header">

               <padding>
                  <Insets bottom="16" left="20" right="20" top="16" />
               </padding>

               <children>

                  <VBox spacing="4.0">

                     <Label styleClass="table-title" text="Répertoire des contacts" />

                     <Label styleClass="table-subtitle" text="Liste des personnes enregistrées dans l'annuaire." />

                  </VBox>

               </children>
            </HBox>


            <!-- TABLEAU DES CONTACTS -->
            <TableView fx:id="tableViewContacts" styleClass="contacts-table" VBox.vgrow="ALWAYS">

               <!-- MESSAGE SI LE TABLEAU EST VIDE -->
               <placeholder>
                  <Label styleClass="table-placeholder" text="Aucun contact disponible." />
               </placeholder>

               <columns>

                  <TableColumn fx:id="colNom" prefWidth="180.0" text="NOM COMPLET" />

                  <TableColumn fx:id="colFonction" prefWidth="160.0" text="FONCTION / RÔLE" />

                  <TableColumn fx:id="colDistrict" prefWidth="130.0" text="DISTRICT" />

                  <TableColumn fx:id="colTelephone" prefWidth="120.0" text="TÉLÉPHONE" />

                  <!-- 🚀 AJOUT DE LA COLONNE MOTIF / OBSERVATION -->
                  <TableColumn fx:id="colObservation" prefWidth="180.0" text="MOTIF / OBSERVATION" />

                  <TableColumn fx:id="colActions" prefWidth="100.0" text="ACTIONS" />

               </columns>


               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>

            </TableView>


            <!-- PIED DU TABLEAU -->
            <HBox alignment="CENTER_LEFT" prefHeight="26.0" prefWidth="873.0" styleClass="table-footer">

               <padding>
                  <Insets bottom="12" left="20" right="20" top="12" />
               </padding>

               <children>

                  <Label styleClass="footer-label" text="ANNUAIRE ADMINISTRATIF" />

               </children>
            </HBox>

         </children>
      </VBox>

   </children>

</VBox>
