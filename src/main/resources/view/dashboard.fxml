<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" prefHeight="680.0" prefWidth="1250.0" styleClass="root-pane" stylesheets="@../css/dashboard.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.contact.controller.DashboardController">

   <!-- ===================================
        SIDEBAR : UNIQUEMENT LES MENUS
   ==================================== -->

   <left>
      <VBox minWidth="255.0" prefWidth="255.0" spacing="5.0" styleClass="sidebar">

         <padding>
            <Insets bottom="12" left="12" right="12" top="12" />
         </padding>

         <children>

            <Label styleClass="sidebar-heading" text="NAVIGATION" />

            <!-- MENUS DEFILANTS -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="sidebar-scroll" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">

               <content>
                  <VBox spacing="2.0" styleClass="menu-container">

                     <padding>
                        <Insets bottom="5" top="5" />
                     </padding>

                     <children>

                        <Button maxWidth="Infinity" onAction="#chargerTousContacts" styleClass="menu-button" text="📁  Tous les contacts" />

                        <Label styleClass="menu-section-title" text="GESTION TERRITORIALE">
                           <VBox.margin>
                              <Insets bottom="3" left="8" top="10" />
                           </VBox.margin>
                        </Label>

                        <Button maxWidth="Infinity" onAction="#chargerAdministration" styleClass="menu-button" text="🏛️  Administration" />

                        <Button maxWidth="Infinity" onAction="#chargerKMD" styleClass="menu-button" text="⚖️  KMD (Comité Dina)" />

                        <Button maxWidth="Infinity" onAction="#chargerMaires" styleClass="menu-button" text="🏛️  Maires (9 Districts)" />

                        <Button maxWidth="Infinity" onAction="#chargerForcesOrdre" styleClass="menu-button" text="🛡️  Forces de l'ordre" />

                        <Button maxWidth="Infinity" onAction="#chargerAnnexe" styleClass="menu-button" text="📍  Annexe (Limitrophe)" />

                        <Label fx:id="lblSectionSecurite" styleClass="menu-section-title" text="SÉCURITÉ &amp; SURVEILLANCE">
                           <VBox.margin>
                              <Insets bottom="3" left="8" top="10" />
                           </VBox.margin>
                        </Label>

                        <Button fx:id="btnPersonnesSuspectes" maxWidth="Infinity" onAction="#chargerPersonnesSuspectes" styleClass="menu-button-alert" text="⚠️  Personnes suspectes" />

                        <Label styleClass="menu-section-title" text="PILOTAGE RÉGIONAL">
                           <VBox.margin>
                              <Insets bottom="3" left="8" top="10" />
                           </VBox.margin>
                        </Label>

                        <Button maxWidth="Infinity" onAction="#chargerControleEffectifs" styleClass="menu-button" text="📊  Contrôle effectifs" />

                        <Button maxWidth="Infinity" onAction="#chargerArborescence" styleClass="menu-button" text="🌳  Arborescence territoriale" />

                        <Label fx:id="txtAdmin" styleClass="menu-section-title" text="ADMINISTRATION SYSTÈME">
                           <VBox.margin>
                              <Insets bottom="3" left="8" top="10" />
                           </VBox.margin>
                        </Label>

                        <Button fx:id="btnAdminUtilisateurs" maxWidth="Infinity" onAction="#chargerUtilisateurs" styleClass="menu-button-admin" text="👥  Gérer les utilisateurs" />

                        <Button fx:id="btnAdminJournal" maxWidth="Infinity" onAction="#chargerJournal" styleClass="menu-button-admin" text="📜  Journal d'audit" />

                     </children>
                  </VBox>
               </content>
            </ScrollPane>

            <!-- SEPARATEUR -->
            <VBox maxHeight="1.0" minHeight="1.0" prefHeight="1.0" styleClass="sidebar-separator" />

            <!-- DECONNEXION TOUJOURS VISIBLE -->
            <Button maxWidth="Infinity" minHeight="42.0" onAction="#deconnecter" prefHeight="42.0" styleClass="logout-button" text="🚪  Déconnexion" />

         </children>
      </VBox>
   </left>


   <!-- ===================================
        HEADER : IDENTITE + PROFIL
   ==================================== -->
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="82.0" spacing="20.0" styleClass="header-bar">

         <padding>
            <Insets bottom="12" left="30" right="30" top="12" />
         </padding>

         <children>

            <!-- IDENTITE DU LOGICIEL A GAUCHE -->
            <VBox alignment="CENTER_LEFT" spacing="5.0">

               <Label styleClass="header-title" text="RÉGION ATSIMO-ANDREFANA" />

               <Label styleClass="header-subtitle" text="Annuaire &amp; Gestion des Contacts" />

            </VBox>

            <!-- ESPACE FLEXIBLE -->
            <StackPane HBox.hgrow="ALWAYS" />

            <!-- PROFIL UTILISATEUR A DROITE -->
            <HBox alignment="CENTER" spacing="12.0" styleClass="user-profile">

               <StackPane prefHeight="42.0" prefWidth="42.0" styleClass="user-avatar">

                  <Label styleClass="avatar-letter" text="U" />

               </StackPane>

               <VBox alignment="CENTER_LEFT" spacing="4.0">

                  <Label fx:id="lblNomUtilisateur" styleClass="user-name-label" text="Nom de l'utilisateur" />

                  <Label fx:id="lblRoleUtilisateur" styleClass="user-role-label" text="ADMINISTRATEUR" />

               </VBox>

            </HBox>

         </children>
      </HBox>
   </top>

   <!-- ===================================
        CONTENU CENTRAL
   ==================================== -->
   <center>
      <VBox fx:id="contentArea" alignment="CENTER" spacing="15.0" styleClass="content-area">

         <padding>
            <Insets bottom="30" left="30" right="30" top="30" />
         </padding>

         <children>

            <VBox alignment="CENTER" spacing="14.0" styleClass="welcome-card">

               <Label styleClass="welcome-title" text="Bienvenue dans votre espace de gestion" />

               <Label styleClass="welcome-subtitle" text="Annuaire territorial de la Région Atsimo-Andrefana" />

               <Label styleClass="welcome-description" text="Sélectionnez une catégorie dans le menu latéral pour commencer." wrapText="true" />

            </VBox>

         </children>
      </VBox>
   </center>

</BorderPane>
