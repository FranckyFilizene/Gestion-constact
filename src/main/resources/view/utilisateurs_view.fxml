<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="22.0"
      styleClass="users-page"
      stylesheets="@../css/utilisateurs.css"
      xmlns="http://javafx.com/javafx/25.0.4"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.contact.controller.UtilisateurController">

   <padding>
      <Insets top="28" right="30" bottom="25" left="30"/>
   </padding>

   <children>

      <!-- EN-TÊTE -->
      <HBox alignment="CENTER_LEFT" spacing="15.0">

         <children>
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Gestion des utilisateurs"
                         styleClass="page-title"/>

                  <Label text="Administrez les comptes et les rôles d'accès au système"
                         styleClass="page-subtitle"/>
               </children>
            </VBox>

            <HBox alignment="CENTER" spacing="8.0"
                  styleClass="security-indicator">
               <children>
                  <FontIcon iconLiteral="fas-shield-alt"
                            iconSize="15"
                            styleClass="security-icon"/>
                  <Label text="Administration"
                         styleClass="security-text"/>
               </children>
            </HBox>
         </children>
      </HBox>

      <!-- INFORMATIONS -->
      <HBox alignment="CENTER_LEFT" spacing="12.0"
            styleClass="users-info-card">

         <children>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Comptes du système"
                         styleClass="info-title"/>
                  <Label text="Consultez et gérez les utilisateurs autorisés à accéder à l'application."
                         styleClass="info-description"/>
               </children>
            </VBox>

            <FontIcon iconLiteral="fas-users-cog"
                      iconSize="30"
                      styleClass="info-icon"/>
         </children>
      </HBox>

      <!-- TABLEAU -->
      <VBox spacing="0.0" VBox.vgrow="ALWAYS"
            styleClass="users-table-card">

         <children>

            <HBox alignment="CENTER_LEFT" spacing="10.0"
                  styleClass="table-card-header">

               <children>
                  <FontIcon iconLiteral="fas-users"
                            iconSize="17"
                            styleClass="table-header-icon"/>

                  <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Liste des utilisateurs"
                               styleClass="table-title"/>
                        <Label text="Gestion des comptes et des autorisations"
                               styleClass="table-subtitle"/>
                     </children>
                  </VBox>

                  <Label text="Comptes enregistrés"
                         styleClass="table-counter"/>
               </children>
            </HBox>

            <TableView fx:id="tableViewUtilisateurs"
                       styleClass="users-table"
                       VBox.vgrow="ALWAYS">

               <placeholder>
                  <VBox alignment="CENTER" spacing="10.0">
                     <children>
                        <FontIcon iconLiteral="fas-user-slash"
                                  iconSize="30"
                                  styleClass="empty-icon"/>
                        <Label text="Aucun utilisateur disponible"
                               styleClass="empty-title"/>
                        <Label text="Les comptes utilisateurs apparaîtront ici."
                               styleClass="empty-description"/>
                     </children>
                  </VBox>
               </placeholder>

               <columns>
                  <TableColumn fx:id="colId"
                               prefWidth="65.0"
                               text="ID"/>

                  <TableColumn fx:id="colLogin"
                               prefWidth="180.0"
                               text="Nom d'utilisateur"/>

                  <TableColumn fx:id="colNomComplet"
                               prefWidth="250.0"
                               text="Nom complet"/>

                  <TableColumn fx:id="colRole"
                               prefWidth="140.0"
                               text="Rôle"/>

                  <TableColumn fx:id="colActif"
                               prefWidth="110.0"
                               text="Statut"/>

                  <TableColumn fx:id="colActions"
                               prefWidth="200.0"
                               text="Actions"/>
               </columns>

               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
               </columnResizePolicy>

            </TableView>

            <HBox alignment="CENTER_LEFT"
                  styleClass="table-footer">
               <children>
                  <Label text="GESTION DES ACCÈS • SYSTÈME DE SÉCURITÉ DINA"
                         styleClass="footer-label"/>
               </children>
            </HBox>

         </children>
      </VBox>

   </children>
</VBox>
